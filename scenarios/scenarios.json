  {
    "id": "003",
    "branch": "bug/003-missing-env-var",
    "title": "Payment crashes: required environment variable is not set",
    "requests": [
      {
        "method": "POST",
        "path": "/signup",
        "json": {
          "email": "a@test.com",
          "name": "Alice",
          "password": "secret123"
        }
      },
      {
        "method": "POST",
        "path": "/payments",
        "json": {
